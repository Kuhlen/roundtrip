import { ListView } from "std-widgets.slint";
import { Theme } from "../../../theme.slint";
import { WorkspaceState, TreeRow } from "../workspace_state.slint";
import { Btn } from "../../../widgets/btn.slint";
import { Field } from "../../../widgets/field.slint";
import { Select } from "../../../widgets/select.slint";

component TreeLine inherits Rectangle {
    in property <TreeRow> item;
    callback clicked();
    callback new-request();
    callback new-folder();
    callback rename();
    callback delete();
    callback settings();
    callback close();
    callback rename-commit(string);
    callback rename-cancel();
    callback done();
    height: 28px;
    background: root.item.active ? Theme.accent-soft : touch.has-hover ? #ffffff08 : transparent;
    if root.item.active: Rectangle {
        x: 0;
        width: 2px;
        background: Theme.accent;
    }
    property <bool> branch: root.item.folder || root.item.collection;
    HorizontalLayout {
        // method labels right-aligned at 38 px + 20 px per level, chevron at 8 px
        padding-left: root.branch ? 8px + root.item.depth * 20px : root.item.depth * 20px;
        padding-right: 12px;
        spacing: 8px;
        if root.branch: Text {
            width: 12px;
            text: root.item.expanded ? "▾" : "▸";
            color: Theme.faint;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if !root.branch: Text {
            width: 38px;
            text: root.item.label;
            font-family: Theme.mono;
            font-size: 10.5px;
            font-weight: 600;
            color: Theme.method-color(root.item.label);
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if !root.item.editing: Text {
            horizontal-stretch: 1;
            text: root.item.name;
            color: root.item.folder ? Theme.muted : Theme.text;
            font-weight: root.item.collection ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.item.editing: FocusScope {
            horizontal-stretch: 1;
            // Esc cancels; Enter commits through accepted
            capture-key-pressed(e) => {
                if e.text == Key.Escape {
                    root.rename-cancel();
                    root.done();
                    return accept;
                }
                reject
            }
            Field {
                y: (parent.height - self.height) / 2;
                width: 100%;
                height: 24px;
                text: root.item.name;
                accepted => {
                    root.rename-commit(self.text);
                    root.done();
                }
                // clicking elsewhere ends the rename
                changed has-focus => {
                    if !self.has-focus {
                        root.rename-cancel();
                    }
                }
                init => {
                    self.focus();
                    self.select-all();
                }
            }
        }
        if root.item.dirty: Text { text: "●"; color: Theme.accent; font-size: 10px; vertical-alignment: center; }
    }
    touch := TouchArea {
        // disabled while renaming so clicks reach the field
        enabled: !root.item.editing;
        clicked => { root.clicked(); }
    }
    // TouchArea grabs every press, so menu is a later sibling, not its parent. Non-right presses fall through
    ContextMenuArea {
        enabled: !root.item.editing;
        Menu {
            MenuItem {
                title: "New request";
                activated => { root.new-request(); }
            }
            MenuItem {
                title: "New folder";
                activated => { root.new-folder(); }
            }
            MenuSeparator { }
            if root.item.collection: MenuItem {
                title: "Collection settings…";
                activated => { root.settings(); }
            }
            if root.item.collection: MenuItem {
                title: "Close collection";
                activated => { root.close(); }
            }
            if !root.item.collection: MenuItem {
                title: "Rename";
                activated => { root.rename(); }
            }
            if !root.item.collection: MenuItem {
                title: "Delete";
                activated => { root.delete(); }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    callback focus-tree();
    background: Theme.side;
    VerticalLayout {
        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 14px;
            padding-bottom: 12px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 4px;
                Text {
                    horizontal-stretch: 1;
                    text: "COLLECTIONS";
                    font-size: 11px;
                    letter-spacing: 0.66px;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
                add-menu := ContextMenuArea {
                    width: plus.preferred-width;
                    // Btn fixes its own height; preferred-height is smaller and lifts the "+"
                    height: plus.height;
                    enabled: WorkspaceState.has-collection;
                    Menu {
                        MenuItem {
                            title: "New request";
                            activated => { WorkspaceState.new-request(-1); }
                        }
                        MenuItem {
                            title: "New folder";
                            activated => { WorkspaceState.new-folder(-1); }
                        }
                    }
                    plus := Btn {
                        text: "+";
                        small: true;
                        ghost: true;
                        enabled: WorkspaceState.has-collection;
                        clicked => { add-menu.show({ x: 0px, y: self.height + 4px }); }
                    }
                }
                Btn {
                    text: "Open…";
                    small: true;
                    ghost: true;
                    clicked => { WorkspaceState.open-collection(); }
                }
            }
            Text { text: "ENVIRONMENT"; font-size: 11px; letter-spacing: 0.66px; color: Theme.faint; }
            Select {
                model: WorkspaceState.environments;
                current-index <=> WorkspaceState.environment-index;
                font-weight: 500;
                enabled: WorkspaceState.has-collection;
                selected => { WorkspaceState.environment-selected(); }
            }
        }
        Rectangle { height: 1px; background: Theme.line-soft; }
        if !WorkspaceState.has-collection: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: 24px;
            Text {
                text: "Open an ApiArk collection, or press Ctrl+T for a scratch request";
                color: Theme.faint;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if WorkspaceState.has-collection: VerticalLayout {
            vertical-stretch: 1;
            padding-top: 6px;
            padding-bottom: 6px;
            ListView {
                for row[i] in WorkspaceState.tree: TreeLine {
                    item: row;
                    clicked => {
                        WorkspaceState.row-clicked(i);
                        root.focus-tree();
                    }
                    new-request => { WorkspaceState.new-request(i); }
                    new-folder => { WorkspaceState.new-folder(i); }
                    rename => { WorkspaceState.rename-start(i); }
                    delete => { WorkspaceState.delete-row(i); }
                    settings => { WorkspaceState.collection-settings(i); }
                    close => { WorkspaceState.close-collection(i); }
                    rename-commit(text) => { WorkspaceState.rename-commit(text); }
                    rename-cancel => { WorkspaceState.rename-cancel(); }
                    done => { root.focus-tree(); }
                }
            }
        }
    }
}
