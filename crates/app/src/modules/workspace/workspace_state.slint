import { KvRow } from "../../snippets/kv_table.slint";
import { AuthFields } from "../../snippets/auth_form.slint";

export enum SendStatus { idle, sending, done, failed, cancelled }
export enum StatusClass { ok, warn, err }
export enum KvTable { params, headers, form }
export enum DialogKind { untitled, delete, clear-history, environment-delete, environment-unsaved }
// draft: New/Duplicate not saved yet
export struct EnvListRow { name: string, personal: bool, draft: bool }
export struct TabItem { title: string, dirty: bool, pinned: bool, active: bool, untitled: bool }
// failed: the send ended in an error, status is "—"
export struct HistoryRow { method: string, url: string, status: string, status-class: StatusClass, failed: bool, time: string }
export struct TreeRow { depth: int, name: string, label: string, folder: bool, collection: bool, expanded: bool, active: bool, dirty: bool, editing: bool }

// in = pushed from Rust; in-out = form state owned by Slint, read by Rust
export global WorkspaceState {
    // sidebar
    in property <bool> has-collection;
    // [0] = "No environment"
    in property <[string]> environments;
    in-out property <int> environment-index;
    in property <[TreeRow]> tree;
    // tree index of the active request, -1 = none (F2 / Del target)
    in property <int> active-row: -1;

    // history: sidebar shows it instead of the tree
    in-out property <bool> show-history;
    in-out property <string> history-query;
    in property <[HistoryRow]> history;
    // "" = rows to show; else the empty or error text
    in property <string> history-note;

    // tabs
    in property <[TabItem]> tabs;
    // index into tabs, -1 = none
    in property <int> active-tab: -1;

    // request
    in property <bool> has-request;
    // "users /", "" at the collection root
    in property <string> crumb;
    in property <string> request-name;
    in property <string> request-file;
    in property <[string]> methods;
    in-out property <int> method-index;
    in-out property <string> url;
    in property <string> resolved-url;
    // last row is always the empty placeholder
    in property <[KvRow]> params;
    in property <[KvRow]> headers;
    in property <int> param-count;
    in property <int> header-count;
    in property <[string]> body-kinds;
    in-out property <int> body-kind-index;
    in-out property <string> body;
    // urlencoded and form-data share the rows; last row is the placeholder
    in property <[KvRow]> form-rows;
    in property <int> body-count;
    in-out property <string> binary-path;
    // shown instead of the editor when unsupported-body != ""
    in property <string> body-note;
    // body type name, "" = editable
    in property <string> unsupported-body;
    // protocol name, "" = sendable
    in property <string> unsupported-protocol;
    in-out property <AuthFields> request-auth;
    // note shown under "Inherit"
    in property <string> inherited-auth;
    // effective auth (own or inherited) is unsupported
    in property <bool> auth-blocked;
    in property <bool> dirty;
    // GraphQL request: Query tab replaces the body editor
    in property <bool> graphql;
    in-out property <string> gql-query;
    in-out property <string> gql-variables;
    in-out property <string> gql-operation;
    // "" = Variables are valid JSON
    in property <string> body-error;
    in-out property <int> editor-tab;

    // response
    in property <SendStatus> send-status;
    in property <string> status-text;
    in property <StatusClass> status-class;
    in property <string> elapsed;
    in property <string> size;
    in property <bool> truncated;
    in property <string> response-raw;
    // "" = body is not JSON
    in property <string> response-pretty;
    in property <[KvRow]> response-headers;
    in-out property <bool> pretty: true;
    in-out property <int> response-tab;
    in property <string> fail-title;
    in property <string> fail-hint;
    in property <string> fail-detail;

    // banner + confirm dialog
    in property <string> banner-title;
    in property <string> banner-hint;
    in property <bool> confirm-open;
    in property <bool> settings-open;
    in-out property <AuthFields> settings-auth;
    in property <string> confirm-name;
    in property <string> confirm-file;
    in property <DialogKind> dialog-kind;
    in property <bool> confirm-folder;

    // save as dialog
    in property <bool> save-as-open;
    in-out property <string> save-as-name;
    // open collection names; empty = Save disabled
    in property <[string]> save-as-collections;
    in-out property <int> save-as-collection-index;
    // "/", "/ users", "/ users / admin"
    in property <[string]> save-as-folders;
    in-out property <int> save-as-folder-index;
    in property <string> save-as-error;

    // import dialog
    in property <bool> import-open;
    in property <string> import-title;
    in-out property <string> import-name;
    // "1 folder · 2 requests · 1 environment"
    in property <string> import-counts;
    in property <[string]> import-warnings;
    in property <string> import-error;

    // environment dialog
    in property <bool> envs-open;
    in property <string> envs-title;
    // stored environments, then the draft
    in property <[EnvListRow]> env-list;
    // -1 = none
    in property <int> env-index: -1;
    in-out property <string> env-name;
    // 0 = Shared, 1 = Personal
    in-out property <int> env-scope-index;
    // last row is the placeholder
    in property <[KvRow]> env-rows;
    in-out property <bool> env-show-secrets;
    in property <bool> env-dirty;
    in property <[string]> env-notes;
    in property <string> env-error;

    out property <bool> can-send: self.has-request && self.send-status != SendStatus.sending && self.unsupported-body == "" && self.unsupported-protocol == "" && !self.auth-blocked && self.body-error == "";

    callback open-collection();
    callback environment-selected();
    callback row-clicked(int);
    callback changed();
    // URL field edit; a pasted curl command fills the request
    callback url-edited();
    // active request as a curl command; "" = can't, banner says why
    callback curl-command() -> string;
    // -1 = binary path, >= 0 = form row
    callback pick-file(int);
    callback kv-edited(KvTable, int);
    callback kv-removed(KvTable, int);
    callback send();
    // Cancel button / Esc while the shown tab is sending
    callback cancel();
    callback save();
    callback dismiss-banner();
    callback confirm-cancel();
    // untitled dialog
    callback confirm-save-as();
    callback confirm-discard();
    callback save-as-confirm();
    callback save-as-cancel();
    callback import-collection();
    callback import-confirm();
    callback import-cancel();
    callback save-as-collection-selected();
    callback open-settings();
    callback save-settings();
    callback close-settings();
    // int = collection row index
    callback collection-settings(int);
    callback export-collection(int);
    callback close-collection(int);
    // int = tree row index, -1 = first collection
    callback new-request(int);
    callback new-folder(int);
    callback rename-start(int);
    callback rename-commit(string);
    callback rename-cancel();
    callback delete-row(int);
    callback confirm-delete();
    // int = tab index
    callback tab-clicked(int);
    callback tab-close(int);
    callback tab-new();
    callback tab-duplicate(int);
    callback tab-pin(int);
    callback tab-close-others(int);
    callback tab-close-all();
    // from, to
    callback tab-moved(int, int);
    // worker queued a send result
    callback response-ready();
    // search edited or History shown: reload the list
    callback history-refresh();
    callback history-clicked(int);
    callback history-clear();
    callback confirm-clear-history();
    callback open-environments();
    // int = env-list index
    callback env-selected(int);
    callback env-new();
    callback env-duplicate();
    callback env-delete();
    callback env-edited(int);
    callback env-removed(int);
    // name or scope edited
    callback env-changed();
    callback env-save();
    callback env-cancel();
    callback env-close();
    callback confirm-env-save();
    callback confirm-env-discard();
    callback confirm-env-delete();
}
