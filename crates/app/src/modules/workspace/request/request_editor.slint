import { Theme } from "../../../theme.slint";
import { WorkspaceState, KvTable, SendStatus } from "../workspace_state.slint";
import { Btn } from "../../../widgets/btn.slint";
import { Field } from "../../../widgets/field.slint";
import { Note } from "../../../widgets/note.slint";
import { BodyEditor } from "body_editor.slint";
import { Select } from "../../../widgets/select.slint";
import { Tab } from "../../../widgets/tab.slint";
import { AuthForm } from "../../../snippets/auth_form.slint";
import { KvTableView } from "../../../snippets/kv_table.slint";

// spans the editor and response columns
export component RequestHeader inherits Rectangle {
    property <bool> copied;

    // Rust builds the text, Slint owns the clipboard
    public function copy-curl() {
        if !WorkspaceState.has-request {
            return;
        }
        clip.text = WorkspaceState.curl-command();
        if clip.text != "" {
            clip.select-all();
            clip.copy();
            root.copied = true;
        }
    }

    clip := TextInput {
        visible: false;
        single-line: false;
    }
    Timer {
        interval: 1.5s;
        running: root.copied;
        triggered => { root.copied = false; }
    }
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 10px;
            if WorkspaceState.crumb != "": Text { text: WorkspaceState.crumb; color: Theme.faint; }
            Text {
                text: WorkspaceState.has-request ? WorkspaceState.request-name : "No request selected";
                font-weight: 600;
                color: WorkspaceState.has-request ? Theme.text : Theme.faint;
            }
            Rectangle { horizontal-stretch: 1; }
            Text { text: WorkspaceState.request-file; font-family: Theme.mono; font-size: 11px; color: Theme.faint; vertical-alignment: center; }
        }
        HorizontalLayout {
            padding-top: 6px;
            spacing: 8px;
            Select {
                width: 104px;
                font-family: Theme.mono;
                font-size: 12px;
                font-weight: 600;
                value-color: Theme.method-color(self.current-value);
                model: WorkspaceState.methods;
                current-index <=> WorkspaceState.method-index;
                enabled: WorkspaceState.has-request;
                selected => { WorkspaceState.changed(); }
            }
            Field {
                horizontal-stretch: 1;
                text <=> WorkspaceState.url;
                placeholder: "https://";
                enabled: WorkspaceState.has-request;
                edited => { WorkspaceState.url-edited(); }
            }
            Btn {
                text: root.copied ? "Copied" : "cURL";
                ghost: true;
                enabled: WorkspaceState.has-request;
                clicked => { root.copy-curl(); }
            }
            // one Btn: destroying the clicked (focused) one would drop focus and kill shortcuts
            Btn {
                property <bool> sending: WorkspaceState.send-status == SendStatus.sending;
                text: self.sending ? "Cancel" : "Send";
                hint: self.sending ? "Esc" : "Ctrl ⏎";
                primary: !self.sending;
                enabled: self.sending || WorkspaceState.can-send;
                clicked => {
                    if self.sending {
                        WorkspaceState.cancel();
                    } else {
                        WorkspaceState.send();
                    }
                }
            }
        }
        // what Send will call once {{…}} is filled in
        if WorkspaceState.resolved-url != "": Text {
            text: "→ " + WorkspaceState.resolved-url;
            font-family: Theme.mono;
            font-size: 11px;
            color: Theme.muted;
            overflow: elide;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

export component RequestEditor inherits Rectangle {
    if WorkspaceState.tabs.length == 0: VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 8px;
        Text { text: "Pick a request from the sidebar, or press Ctrl+T"; color: Theme.muted; font-size: 14px; horizontal-alignment: center; }
        Text {
            text: "Roundtrip reads ApiArk collections as they are. Nothing is converted.";
            color: Theme.faint;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    if WorkspaceState.has-request && WorkspaceState.unsupported-protocol != "": VerticalLayout {
        alignment: start;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        Note { text: WorkspaceState.unsupported-protocol + " requests are not supported yet. Open this one in ApiArk for now."; }
    }
    if WorkspaceState.has-request && WorkspaceState.unsupported-protocol == "": VerticalLayout {
        Rectangle {
            height: 38px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 18px;
                Tab {
                    text: "Params";
                    count: WorkspaceState.param-count > 0 ? "\{WorkspaceState.param-count}" : "";
                    active: WorkspaceState.editor-tab == 0;
                    clicked => { WorkspaceState.editor-tab = 0; }
                }
                Tab {
                    text: "Headers";
                    count: WorkspaceState.header-count > 0 ? "\{WorkspaceState.header-count}" : "";
                    active: WorkspaceState.editor-tab == 1;
                    clicked => { WorkspaceState.editor-tab = 1; }
                }
                Tab {
                    text: WorkspaceState.graphql ? "Query" : "Body";
                    count: WorkspaceState.unsupported-body != "" ? WorkspaceState.unsupported-body : WorkspaceState.body-count > 0 ? "\{WorkspaceState.body-count}" : "";
                    active: WorkspaceState.editor-tab == 2;
                    clicked => { WorkspaceState.editor-tab = 2; }
                }
                Tab {
                    text: "Auth";
                    count: WorkspaceState.request-auth.kind != 0 || WorkspaceState.request-auth.unsupported != "" ? "•" : "";
                    active: WorkspaceState.editor-tab == 3;
                    clicked => { WorkspaceState.editor-tab = 3; }
                }
                Rectangle { horizontal-stretch: 1; }
                if WorkspaceState.editor-tab == 2 && WorkspaceState.unsupported-body == "" && !WorkspaceState.graphql: VerticalLayout {
                    alignment: center;
                    Select {
                        width: 112px;
                        small: true;
                        font-family: Theme.mono;
                        font-size: 12px;
                        model: WorkspaceState.body-kinds;
                        current-index <=> WorkspaceState.body-kind-index;
                        selected => { WorkspaceState.changed(); }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line-soft;
            }
        }
        if WorkspaceState.editor-tab == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            padding: 14px;
            padding-top: 12px;
            KvTableView {
                vertical-stretch: 1;
                rows: WorkspaceState.params;
                edited(i) => { WorkspaceState.kv-edited(KvTable.params, i); }
                removed(i) => { WorkspaceState.kv-removed(KvTable.params, i); }
            }
        }
        if WorkspaceState.editor-tab == 1: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            padding: 14px;
            padding-top: 12px;
            KvTableView {
                vertical-stretch: 1;
                rows: WorkspaceState.headers;
                edited(i) => { WorkspaceState.kv-edited(KvTable.headers, i); }
                removed(i) => { WorkspaceState.kv-removed(KvTable.headers, i); }
            }
        }
        if WorkspaceState.editor-tab == 3: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            padding: 14px;
            padding-top: 12px;
            AuthForm {
                auth <=> WorkspaceState.request-auth;
                none-label: "Inherit";
                none-note: WorkspaceState.inherited-auth;
                settings-link: true;
                changed => { WorkspaceState.changed(); }
                open-settings => { WorkspaceState.open-settings(); }
            }
        }
        if WorkspaceState.editor-tab == 2: BodyEditor { vertical-stretch: 1; }
    }
}
