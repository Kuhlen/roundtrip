import { Theme } from "../../theme.slint";
import { WorkspaceState, DialogKind } from "workspace_state.slint";
import { Btn } from "../../widgets/btn.slint";

// Cancel is the default button
export component ConfirmDialog inherits Rectangle {
    property <bool> is-delete: WorkspaceState.dialog-kind == DialogKind.delete;
    background: Theme.scrim;
    // scrim swallows clicks
    TouchArea { }
    // ancestor of the buttons: capture sees Escape before the focused button
    FocusScope {
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                WorkspaceState.confirm-cancel();
                return accept;
            }
            reject
        }
        Rectangle {
            width: 420px;
            height: col.preferred-height;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #00000080;
            col := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: root.is-delete
                        ? "Delete \"" + WorkspaceState.confirm-name + "\"?"
                        : "Save \"" + WorkspaceState.confirm-name + "\" before closing?";
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.is-delete
                        ? "This deletes " + WorkspaceState.confirm-file + (WorkspaceState.confirm-folder ? " and everything in it" : "") + " permanently."
                        : "This request is in no collection yet. Its edits are lost if you discard them.";
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 8px;
                    cancel := Btn {
                        text: "Cancel";
                        ghost: true;
                        clicked => { WorkspaceState.confirm-cancel(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.is-delete: Btn {
                        text: "Delete";
                        text-color: Theme.err;
                        clicked => { WorkspaceState.confirm-delete(); }
                    }
                    if !root.is-delete: Btn {
                        text: "Discard";
                        text-color: Theme.err;
                        clicked => { WorkspaceState.confirm-discard(); }
                    }
                    if !root.is-delete: Btn {
                        text: "Save as…";
                        primary: true;
                        clicked => { WorkspaceState.confirm-save-as(); }
                    }
                }
            }
        }
    }
    init => { cancel.focus(); }
}
