import { Theme } from "../../theme.slint";
import { WorkspaceState, DialogKind } from "workspace_state.slint";
import { Btn } from "../../widgets/btn.slint";

// Save is the default for unsaved edits; Cancel for delete
export component ConfirmDialog inherits Rectangle {
    property <bool> is-delete: WorkspaceState.dialog-kind == DialogKind.delete;
    background: Theme.scrim;
    // scrim swallows clicks
    TouchArea { }
    // ancestor of Save: capture sees Escape before the focused button
    FocusScope {
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                WorkspaceState.confirm-cancel();
                return accept;
            }
            reject
        }
        Rectangle {
            width: 420px;
            height: col.preferred-height;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #00000080;
            col := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: root.is-delete
                        ? "Delete \"" + WorkspaceState.confirm-name + "\"?"
                        : "Save changes to \"" + WorkspaceState.confirm-name + "\"?";
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.is-delete
                        ? "This deletes " + WorkspaceState.confirm-file + (WorkspaceState.confirm-folder ? " and everything in it" : "") + " permanently."
                        : "Your edits to " + WorkspaceState.confirm-file + " are lost if you don't save them.";
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 8px;
                    cancel := Btn {
                        text: "Cancel";
                        ghost: true;
                        clicked => { WorkspaceState.confirm-cancel(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if !root.is-delete: Btn {
                        text: "Discard";
                        text-color: Theme.err;
                        clicked => { WorkspaceState.confirm-discard(); }
                    }
                    main := Btn {
                        text: root.is-delete ? "Delete" : "Save";
                        primary: !root.is-delete;
                        text-color: Theme.err;
                        clicked => {
                            if root.is-delete {
                                WorkspaceState.confirm-delete();
                            } else {
                                WorkspaceState.confirm-save();
                            }
                        }
                    }
                }
            }
        }
    }
    init => {
        if root.is-delete {
            cancel.focus();
        } else {
            main.focus();
        }
    }
}
