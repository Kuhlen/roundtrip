import { Theme } from "../../theme.slint";
import { WorkspaceState, SendStatus } from "workspace_state.slint";
import { ErrorBanner } from "../../snippets/error_banner.slint";
import { Sidebar } from "sidebar/sidebar.slint";
import { RequestHeader, RequestEditor } from "request/request_editor.slint";
import { ResponsePanel } from "response_panel.slint";
import { ConfirmDialog } from "confirm_dialog.slint";
import { CollectionSettings } from "sidebar/collection_settings.slint";
import { TabBar } from "tabs/tab_bar.slint";
import { SaveAsDialog } from "tabs/save_as_dialog.slint";
import { ImportDialog } from "import/import_dialog.slint";
import { VarPopover } from "environments/var_popover.slint";
import { EnvironmentDialog } from "environments/environment_dialog.slint";

export component WorkspaceView inherits Rectangle {
    // Ctrl+S / Ctrl+T / Ctrl+W / Ctrl+Enter / Ctrl+Shift+C; off while a dialog is open
    function shortcut(e: KeyEvent) -> EventResult {
        if root.dialog-open || !e.modifiers.control {
            return reject;
        }
        if e.modifiers.shift && (e.text == "c" || e.text == "C") {
            header.copy-curl();
            return accept;
        }
        if e.text == "t" || e.text == "T" {
            WorkspaceState.tab-new();
            return accept;
        }
        if e.text == "s" || e.text == "S" {
            WorkspaceState.save();
            return accept;
        }
        if e.text == "w" || e.text == "W" {
            if WorkspaceState.active-tab >= 0 {
                WorkspaceState.tab-close(WorkspaceState.active-tab);
            }
            return accept;
        }
        if e.text == Key.Return {
            if WorkspaceState.can-send {
                WorkspaceState.send();
            }
            return accept;
        }
        reject
    }

    // bubble phase: a focused field eats Delete first; the dialog guards the rest
    function tree-key(e: KeyEvent) -> EventResult {
        if root.dialog-open || WorkspaceState.active-row < 0 || e.modifiers.control {
            return reject;
        }
        if e.text == Key.F2 {
            WorkspaceState.rename-start(WorkspaceState.active-row);
            return accept;
        }
        if e.text == Key.Delete {
            WorkspaceState.delete-row(WorkspaceState.active-row);
            return accept;
        }
        reject
    }

    // root scope: capture runs before the focused field sees the key
    keys := FocusScope {
        width: 100%;
        height: 100%;
        capture-key-pressed(e) => { root.shortcut(e) }
        key-pressed(e) => {
            if root.shortcut(e) == EventResult.accept {
                return accept;
            }
            // bubble phase: a renaming tree row eats Esc first
            if !root.dialog-open && e.text == Key.Escape && WorkspaceState.send-status == SendStatus.sending {
                WorkspaceState.cancel();
                return accept;
            }
            root.tree-key(e)
        }
        VerticalLayout {
            width: 100%;
            height: 100%;
            if WorkspaceState.banner-title != "": ErrorBanner {
                title: WorkspaceState.banner-title;
                hint: WorkspaceState.banner-hint;
                dismiss => { WorkspaceState.dismiss-banner(); }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                Sidebar { width: 248px; focus-tree => { keys.focus(); } }
                Rectangle { width: 1px; background: Theme.line-soft; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    TabBar { }
                    header := RequestHeader { }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        RequestEditor { horizontal-stretch: 1; }
                        Rectangle { width: 1px; background: Theme.line-soft; }
                        ResponsePanel { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }
    if WorkspaceState.settings-open: CollectionSettings { }
    if WorkspaceState.save-as-open: SaveAsDialog { }
    if WorkspaceState.import-open: ImportDialog { }
    if WorkspaceState.envs-open: EnvironmentDialog { }
    if WorkspaceState.var-open: VarPopover { }
    // last: asks on top of the environment dialog
    if WorkspaceState.confirm-open: ConfirmDialog { }
    // dialog focus is lost when it closes; shortcuts need keys back
    property <bool> dialog-open: WorkspaceState.confirm-open || WorkspaceState.settings-open || WorkspaceState.save-as-open || WorkspaceState.import-open || WorkspaceState.envs-open || WorkspaceState.var-open;
    changed dialog-open => {
        if !self.dialog-open {
            keys.focus();
        }
    }
    init => { keys.focus(); }
}
