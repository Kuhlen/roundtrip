import { Theme } from "../../theme.slint";
import { WorkspaceState } from "workspace_state.slint";
import { ErrorBanner } from "error_banner.slint";
import { Sidebar } from "sidebar.slint";
import { RequestHeader, RequestEditor } from "request_editor.slint";
import { ResponsePanel } from "response_panel.slint";
import { ConfirmDialog } from "confirm_dialog.slint";
import { CollectionSettings } from "collection_settings.slint";

export component WorkspaceView inherits Rectangle {
    // Ctrl+S / Ctrl+Enter; off while the dialog is open
    function shortcut(e: KeyEvent) -> EventResult {
        if WorkspaceState.confirm-open || WorkspaceState.settings-open || !e.modifiers.control {
            return reject;
        }
        if e.text == "s" || e.text == "S" {
            WorkspaceState.save();
            return accept;
        }
        if e.text == Key.Return {
            if WorkspaceState.can-send {
                WorkspaceState.send();
            }
            return accept;
        }
        reject
    }

    // bubble phase: a focused field eats Delete first; the dialog guards the rest
    function tree-key(e: KeyEvent) -> EventResult {
        if WorkspaceState.confirm-open || WorkspaceState.settings-open || WorkspaceState.active-row < 0 || e.modifiers.control {
            return reject;
        }
        if e.text == Key.F2 {
            WorkspaceState.rename-start(WorkspaceState.active-row);
            return accept;
        }
        if e.text == Key.Delete {
            WorkspaceState.delete-row(WorkspaceState.active-row);
            return accept;
        }
        reject
    }

    // root scope: capture runs before the focused field sees the key
    keys := FocusScope {
        width: 100%;
        height: 100%;
        capture-key-pressed(e) => { root.shortcut(e) }
        key-pressed(e) => {
            if root.shortcut(e) == EventResult.accept {
                return accept;
            }
            root.tree-key(e)
        }
        VerticalLayout {
            width: 100%;
            height: 100%;
            if WorkspaceState.banner-title != "": ErrorBanner { }
            HorizontalLayout {
                vertical-stretch: 1;
                Sidebar { width: 248px; focus-tree => { keys.focus(); } }
                Rectangle { width: 1px; background: Theme.line-soft; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    RequestHeader { }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        RequestEditor { horizontal-stretch: 1; }
                        Rectangle { width: 1px; background: Theme.line-soft; }
                        ResponsePanel { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }
    if WorkspaceState.confirm-open: ConfirmDialog { }
    if WorkspaceState.settings-open: CollectionSettings { }
    // dialog focus is lost when it closes; shortcuts need keys back
    property <bool> dialog-open: WorkspaceState.confirm-open || WorkspaceState.settings-open;
    changed dialog-open => {
        if !self.dialog-open {
            keys.focus();
        }
    }
    init => { keys.focus(); }
}
