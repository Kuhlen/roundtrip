import { Theme } from "../../theme.slint";
import { WorkspaceState } from "workspace_state.slint";

// pushes content down
export component ErrorBanner inherits Rectangle {
    background: Theme.err-bg;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.err-line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;
        Text { text: WorkspaceState.banner-title; font-weight: 600; color: Theme.banner-title; vertical-alignment: center; }
        Text {
            horizontal-stretch: 1;
            text: WorkspaceState.banner-hint;
            color: Theme.banner-hint;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: dismiss.has-hover ? #ffffff14 : transparent;
            accessible-role: button;
            accessible-label: "Dismiss";
            Image { source: @image-url("../../../assets/icons/close.svg"); colorize: Theme.banner-hint; }
            dismiss := TouchArea {
                clicked => { WorkspaceState.dismiss-banner(); }
            }
        }
    }
}
