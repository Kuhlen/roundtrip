import { Theme } from "../../../theme.slint";
import { WorkspaceState } from "../workspace_state.slint";
import { Btn } from "../../../widgets/btn.slint";
import { Field } from "../../../widgets/field.slint";
import { Select } from "../../../widgets/select.slint";

component Label inherits Text {
    font-size: 11px;
    letter-spacing: 0.66px;
    color: Theme.faint;
    vertical-alignment: center;
}

// modal; Enter in the name saves, Esc cancels
export component SaveAsDialog inherits Rectangle {
    property <bool> can-save: WorkspaceState.save-as-collections.length > 0 && WorkspaceState.save-as-name != "";
    background: Theme.scrim;
    // scrim swallows clicks
    TouchArea { }
    // ancestor of the fields: capture sees Escape before the focused field
    FocusScope {
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                WorkspaceState.save-as-cancel();
                return accept;
            }
            reject
        }
        Rectangle {
            width: 440px;
            height: col.preferred-height;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #00000080;
            col := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Save request"; font-size: 15px; font-weight: 600; color: Theme.text; }
                GridLayout {
                    spacing-horizontal: 14px;
                    spacing-vertical: 10px;
                    Row {
                        Label { text: "NAME"; }
                        name := Field {
                            horizontal-stretch: 1;
                            text <=> WorkspaceState.save-as-name;
                            placeholder: "Request name";
                            accepted => {
                                if root.can-save {
                                    WorkspaceState.save-as-confirm();
                                }
                            }
                        }
                    }
                    Row {
                        Label { text: "COLLECTION"; }
                        Select {
                            model: WorkspaceState.save-as-collections;
                            current-index <=> WorkspaceState.save-as-collection-index;
                            enabled: WorkspaceState.save-as-collections.length > 0;
                            selected => { WorkspaceState.save-as-collection-selected(); }
                        }
                    }
                    Row {
                        Label { text: "FOLDER"; }
                        Select {
                            model: WorkspaceState.save-as-folders;
                            current-index <=> WorkspaceState.save-as-folder-index;
                            enabled: WorkspaceState.save-as-folders.length > 0;
                        }
                    }
                }
                if WorkspaceState.save-as-error != "": Text {
                    text: WorkspaceState.save-as-error;
                    color: Theme.err;
                    wrap: word-wrap;
                }
                if WorkspaceState.save-as-collections.length == 0: Text {
                    text: "Open a collection first.";
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    padding-top: 6px;
                    spacing: 8px;
                    alignment: end;
                    Btn {
                        text: "Cancel";
                        ghost: true;
                        clicked => { WorkspaceState.save-as-cancel(); }
                    }
                    Btn {
                        text: "Save";
                        primary: true;
                        enabled: root.can-save;
                        clicked => { WorkspaceState.save-as-confirm(); }
                    }
                }
            }
        }
    }
    init => { name.focus(); }
}
